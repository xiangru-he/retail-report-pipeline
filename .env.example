# Copy to .env and fill in. .env is gitignored.
#
#     cp .env.example .env
#     set -a && source .env && set +a

# ---- MySQL -----------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=retail_demo

# ---- Which store ------------------------------------------------------------
STORE_CODE=DEMO-CENTRAL

# ---- Commentary (optional) --------------------------------------------------
# Without a key the deck still builds — every heading and note falls back to a
# sentence composed from the same figures. See pipeline/step13.
ANTHROPIC_API_KEY=
NARRATIVE_MODEL=claude-sonnet-5
