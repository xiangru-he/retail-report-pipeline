# Credentials — never commit these
.env

# Intermediate CSVs. Regenerated by every run; committing them would mean
# reviewing a few thousand lines of diff each month for no benefit.
data/work/
!data/work/.gitkeep

# Chart PNGs are build artefacts — step14 regenerates them from
# report_data.json in a few seconds, and they are already embedded in the
# .pptx anyway.
output/*/chart_*.png

# Everything else under output/ IS committed on purpose:
#   monthly_report_<period>.pptx  the deliverable, viewable without running anything
#   narrative.json                the model-written commentary. This is what lets
#                                 someone clone the repo with no API key and still
#                                 see the model's output — step15 falls back to it.
#   report_data.json              every figure on every slide, for cross-checking

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node
node_modules/
package-lock.json

# OS
.DS_Store
Thumbs.db
